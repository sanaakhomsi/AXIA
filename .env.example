# Copy these into your hosting dashboard (Vercel: Project → Settings → Environment Variables).
# Never commit real keys to GitHub.

# AI (api/claude.js)
ANTHROPIC_API_KEY=your-key-from-the-claude-console

# Feedback loop (api/feedback.js) — from Supabase: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Access code you give to reviewing clinicians (pick a long random one)
CLINICIAN_CODE=change-me-to-a-long-random-code

# Only if the page is hosted on another domain than the functions, e.g. GitHub Pages:
ALLOWED_ORIGINS=https://yourname.github.io
